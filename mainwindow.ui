   <property name="styleSheet">
    <string notr="true">/* --- Global Font Settings --- */
QWidget {
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    background-color: #F4F7F6; /* Soft light gray background */
}

/* --- Labels (Username &amp; Password) --- */
QLabel {
    color: #2C3E50;
    font-size: 14px;
    font-weight: bold;
    padding-right: 5px;
}

/* --- Text Input Fields (QLineEdit) --- */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #D1D9E6;
    border-radius: 8px; /* Rounded corners */
    padding: 8px 12px;
    font-size: 14px;
    color: #333333;
    min-height: 25px;
}

/* Highlight the text box in blue when the user clicks inside to type */
QLineEdit:focus {
    border: 2px solid #4A90E2; 
    background-color: #FAFCFF;
}

/* Placeholder text styling (if supported by your Qt version) */
QLineEdit::placeholder {
    color: #A0AAB5;
}

/* --- The Login Button (QPushButton) --- */
QPushButton {
    background-color: #4A90E2; /* Modern blue */
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
    min-width: 150px;
}

QPushButton:hover {
    background-color: #357ABD; /* Darker blue on hover */
}

QPushButton:pressed {
    background-color: #285A8F; /* Even darker on click */
    /* Shifts the text down slightly to simulate a physical button press */
    padding-top: 12px; 
    padding-bottom: 8px;
}</string>
