    background-color: #e0e0e0; /* A slightly darker gray for the background */
    color: black;              /* Forces the text to be black */
    font-weight: bold;         /* Optional: makes the headings stand out more */
    border: 1px solid #c0c0c0; /* Optional: adds a nice border between header cells */
    padding: 4px;
}
/* Set the default text and background color for the table */
QTableWidget {
    color: black;
    background-color: white;
}

/* Ensure individual cell text is strictly black when not selected */
QTableWidget::item {
    color: black;
}

/* Keep your nice purple selection highlight */
QTableWidget::item:selected {
    background-color: #6a0dad; /* A close match to the purple in your screenshot */
    color: white;
}</string>
