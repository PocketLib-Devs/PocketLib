   <property name="styleSheet">
    <string notr="true">/* --- Main Background --- */
QWidget {
    background-color: #F8F9FA; /* A very soft, clean light gray */
}

/* --- Labels (Username &amp; Password) --- */
QLabel {
    color: #2C3E50; /* A dark, professional slate gray */
}

/* --- Text Input Fields (QLineEdit) --- */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #DCE1E6; /* Soft gray border */
    border-radius: 5px; /* Subtle rounded corners */
    color: #333333;
    padding: 2px 6px; /* Just enough internal space so text doesn't touch the line */
}

/* Highlight the box in blue when the user is actively typing */
QLineEdit:focus {
    border: 2px solid #007BFF; 
    background-color: #F0F7FF; /* Very faint blue tint */
}

/* --- The Login Button (QPushButton) --- */
QPushButton {
    background-color: #007BFF; /* Primary vibrant blue */
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 6px 12px; /* Internal padding only, does not affect outside layout */
}

/* When the mouse hovers over the button */
QPushButton:hover {
    background-color: #0056B3; /* Darker blue */
}

/* When the button is actively clicked */
QPushButton:pressed {
    background-color: #004085; /* Deepest blue */
}</string>
