    <string notr="true">/* --- Main Background --- */
QWidget {
    background-color: #F8F9FA;
}
QLabel {
    color: #2C3E50;
}
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #DCE1E6;
    border-radius: 5px;
    color: #333333;
    padding: 2px 6px;
}
QLineEdit:focus {
    border: 2px solid #007BFF;
    background-color: #F0F7FF;
}
QPushButton {
    background-color: #007BFF;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #0056B3;
}
QPushButton:pressed {
    background-color: #004085;
}</string>
